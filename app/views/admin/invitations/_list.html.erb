<% if invitations.any? %>
  <div class="invitation-list">
    <% invitations.each do |invitation| %>
      <div class="invitation-list__item">
        <div>
          <h3 class="invitation-list__name"><%= [invitation.first_name, invitation.last_name].join(" ") %></h3>
          <p class="invitation-list__meta">
            Invited by <%= invitation.invited_by.person_card.name.presence || "Unnamed person" %>
          </p>
          <p class="invitation-list__email">
            <%= invitation.email_address %>
          </p>
        </div>

        <div class="invitation-list__actions">
          <span class="invitation-list__role"><%= invitation.role.titleize %></span>
          <% if cancellable %>
            <%= admin_invitation_actions.cancel_button_for(invitation) %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="empty-state empty-state--compact">
    <p class="empty-state__message"><%= empty_message %></p>
  </div>
<% end %>
