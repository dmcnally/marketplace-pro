<div class="login">
  <div class="login__card">
    <h1 class="login__title">Create account</h1>

    <%= form_with model: @registration, url: registration_path, class: "login__form" do |form| %>
      <% if @registration.errors.any? %>
        <div class="login__alert">
          <%= @registration.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <div class="form-field">
        <%= form.label :first_name, "First name", class: "form-field__label" %>
        <%= form.text_field :first_name, required: true, autofocus: true, autocomplete: "given-name", class: "form-field__input" %>
      </div>

      <div class="form-field">
        <%= form.label :last_name, "Last name", class: "form-field__label" %>
        <%= form.text_field :last_name, required: true, autocomplete: "family-name", class: "form-field__input" %>
      </div>

      <div class="form-field">
        <%= form.label :email_address, "Email address", class: "form-field__label" %>
        <%= form.email_field :email_address, required: true, autocomplete: "username", placeholder: "you@example.com", class: "form-field__input" %>
      </div>

      <div class="form-field">
        <%= form.label :password, "Password", class: "form-field__label" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "form-field__input" %>
      </div>

      <div class="form-field">
        <%= form.label :password_confirmation, "Confirm password", class: "form-field__label" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "form-field__input" %>
      </div>

      <%= form.submit "Create account", class: "btn btn--primary login__submit" %>
    <% end %>

    <div class="login__footer">
      <%= session_actions.sign_in_instead_link %>
    </div>
  </div>
</div>
