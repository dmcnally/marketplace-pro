<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Workspace overview · Marketplace" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="workspace">
    <%= render "layouts/sys_admin_banner" %>
    <div class="workspace__layout">
      <aside class="workspace__sidebar">
        <%= link_to "Marketplace", root_path, class: "workspace__brand" %>
        <p class="workspace__eyebrow">EDITORIAL WORKSPACE</p>
        <nav class="workspace__nav" aria-label="Admin">
          <%= link_to "Overview", admin_root_path, class: "workspace__nav-link workspace__nav-link--active", aria: { current: "page" } %>
          <%= link_to "Articles", articles_path, class: "workspace__nav-link" %>
          <%= link_to "Members", admin_members_path, class: "workspace__nav-link" %>
          <%= link_to "Invitations", admin_invitations_path, class: "workspace__nav-link" %>
          <%= link_to "Imports", admin_csv_imports_path, class: "workspace__nav-link" %>
          <%= link_to "Activity", "#recent-activity", class: "workspace__nav-link" %>
          <%= link_to "Settings", "#workspace-preferences", class: "workspace__nav-link" %>
        </nav>
        <div class="workspace__note"><strong>Make room for ideas</strong><p>Your team’s writing, all in one place.</p></div>
      </aside>
      <main class="workspace__main"><%= yield %></main>
    </div>
  </body>
</html>
