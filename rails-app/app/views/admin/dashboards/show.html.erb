<% content_for :title, "Manage users · Marketplace" %>

<div class="page">
  <div class="page-header">
    <div>
      <h1 class="page-header__title">Manage users</h1>
      <p>Members and invitations for <%= @overview.bucket.name %>.</p>
    </div>
    <%= admin_invitation_actions.new_link(label: "Invite member") %>
  </div>

  <div class="dashboard-summary">
    <section class="dashboard-summary__item">
      <h2 class="dashboard-summary__label">Team members</h2>
      <p class="dashboard-summary__value"><%= @overview.member_count %></p>
      <p>See who has access and their current roles.</p>
      <%= link_to "View members", admin_members_path, class: "btn btn--secondary" %>
    </section>
    <section class="dashboard-summary__item">
      <h2 class="dashboard-summary__label">Pending invitations</h2>
      <p class="dashboard-summary__value"><%= @overview.invitations.size %></p>
      <p><%= pluralize(@overview.invitations.size, "invitation") %> still pending</p>
      <%= link_to "Manage invitations", admin_invitations_path, class: "btn btn--secondary" %>
    </section>
  </div>
</div>
