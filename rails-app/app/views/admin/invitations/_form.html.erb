<%= form_with model: invitation, url: admin_invitations_path, class: "form" do |form| %>
  <% if invitation.errors.any? %>
    <div class="form-errors">
      <h2 class="form-errors__title"><%= pluralize(invitation.errors.count, "error") %> prohibited this invitation from being saved:</h2>
      <ul class="form-errors__list">
        <% invitation.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-field">
    <%= form.label :email_address, class: "form-field__label" %>
    <%= form.email_field :email_address, class: "form-field__input", autofocus: true %>

    <%= form.label :first_name, class: "form-field__label" %>
    <%= form.text_field :first_name, class: "form-field__input" %>

    <%= form.label :last_name, class: "form-field__label" %>
    <%= form.text_field :last_name, class: "form-field__input" %>
  </div>

  <div class="form-field">
    <%= form.label :role, class: "form-field__label" %>
    <%= form.select :role,
                    Membership.roles.keys.map { |role| [ role.titleize, role ] },
                    {},
                    class: "form-field__input" %>
  </div>

  <div class="form-actions">
    <%= form.submit "Create Invitation", class: "btn btn--primary" %>
    <%= admin_invitation_actions.form_cancel_link %>
  </div>
<% end %>
