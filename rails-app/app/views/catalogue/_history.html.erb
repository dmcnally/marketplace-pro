<section class="catalogue__panel">
  <h2>Who changed what</h2>
  <p class="catalogue__muted">Newest changes first · Read-only history</p>
  <% events.each do |event| %>
    <div class="catalogue__row">
    <article class="catalogue__record" id="<%= dom_id(event, :history) %>">
      <strong><%= event.action.humanize %> · <%= event.subject.timeline_description(event) %></strong>
      <p class="catalogue__muted"><%= event.person&.person_card&.name.presence || "System" %> · <%= time_tag event.created_at, event.created_at.strftime("%d %b %Y, %H:%M %Z") %></p>
      <% if (availability_change = catalogue_availability_change(event)) %>
        <p><%= availability_change %></p>
      <% end %>
      <% publication = Catalogue::PublicationDiff.new(event) %>
      <% if publication.available? %>
        <details class="catalogue__history-comparison">
          <summary class="btn btn--secondary">Compare published versions</summary>
          <p class="catalogue__muted"><%= publication.first_publication? ? "First publication" : "Changes since the previous publication" %></p>
          <% if publication.changes.empty? %>
            <p>No content changes since the previous publication.</p>
          <% else %>
            <dl class="catalogue__comparison">
              <% publication.changes.each do |change| %>
                <dt><%= change[:field] %></dt>
                <dd><del><%= catalogue_publication_value(change[:field], change[:before]) %></del> → <ins><%= catalogue_publication_value(change[:field], change[:after]) %></ins></dd>
              <% end %>
            </dl>
          <% end %>
        </details>
      <% end %>
      <% if event.subject_previous %>
        <details class="catalogue__history-comparison">
          <summary class="btn btn--secondary">Compare changes</summary>
          <dl class="catalogue__comparison">
            <% RecordableDiff.new(current: event.subject, previous: event.subject_previous, event: event).changes.each do |field, values| %>
              <dt><%= field.humanize %></dt>
              <dd><del><%= catalogue_history_value(event, field, values.first) %></del> → <ins><%= catalogue_history_value(event, field, values.last) %></ins></dd>
            <% end %>
          </dl>
        </details>
      <% end %>
    </article>
    </div>
  <% end %>
</section>
