<section class="catalogue__panel">
  <h2>Changes</h2>
  <% events.each do |event| %>
    <article class="catalogue__record">
      <strong><%= event.action.humanize %> · <%= event.subject.timeline_description(event) %></strong>
      <p class="catalogue__muted"><%= event.person&.person_card&.name.presence || "System" %> · <%= time_tag event.created_at, event.created_at.strftime("%d %b %Y, %H:%M %Z") %></p>
      <% if (availability_change = catalogue_availability_change(event)) %>
        <p><%= availability_change %></p>
      <% end %>
      <% if event.subject_previous %>
        <details>
          <summary>Compare changes</summary>
          <dl class="catalogue__comparison">
            <% RecordableDiff.new(current: event.subject, previous: event.subject_previous, event: event).changes.each do |field, values| %>
              <dt><%= field.humanize %></dt>
              <dd><del><%= catalogue_history_value(event, field, values.first) %></del> → <ins><%= catalogue_history_value(event, field, values.last) %></ins></dd>
            <% end %>
          </dl>
        </details>
      <% end %>
    </article>
  <% end %>
</section>
