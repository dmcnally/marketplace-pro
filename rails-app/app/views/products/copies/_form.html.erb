<%= form_with model: copy, url: admin_product_copy_path(copy.source), class: "catalogue__panel" do |form| %>
  <h2>Copy <%= copy.source.recordable.name %></h2>
  <p class="catalogue__muted">Copies details, image, categories and active variant content into a new unpublished draft. Each copied variant is unavailable, regardless of the source availability.</p>
  <% if copy.errors.any? %><div class="catalogue__notice" role="alert"><%= copy.errors.full_messages.join(". ") %></div><% end %>
  <%= hidden_field_tag :revision, copy.revision %>
  <div class="catalogue__field"><%= form.label :name, "New name *" %><%= form.text_field :name, required: true, aria: { invalid: copy.errors[:name].any? } %></div>
  <div class="catalogue__actions"><%= form.submit "Create copy", class: "btn btn--primary" %><%= link_to "Cancel", edit_admin_product_path(copy.source), class: "btn btn--secondary" %></div>
<% end %>
