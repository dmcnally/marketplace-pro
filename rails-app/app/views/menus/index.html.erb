<h1>Menus</h1>
<p class="catalogue__muted"><%= Current.bucket.name %> · One live menu at a time</p>
<%= menu_actions.new_link %>
<section class="catalogue__panel">
  <h2>Your menus</h2>
  <% @menus.each do |menu| %>
    <div class="catalogue__row">
      <div class="catalogue__record"><strong><%= menu.recordable.name %></strong><p class="catalogue__muted">Draft · <%= pluralize menu.recordable.section_order.size, "section" %></p></div>
      <%= menu_actions.edit_link_for(menu) %>
    </div>
  <% end %>
  <% if @menus.empty? %><p class="catalogue__muted">No menus yet. Create a menu, then add sections and products.</p><% end %>
</section>
